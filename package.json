{
  "name": "dmgn-agency",
  "version": "1.0.0",
  "private": true,
  "description": "DMGN — Creative Agency. Static site for Cloudflare Pages.",
  "scripts": {
    "build": "node scripts/build.js",
    "build:images": "bash scripts/build-images.sh",
    "dev": "wrangler pages dev public --compatibility-date=2026-05-01",
    "serve": "node scripts/build.js && npx --yes http-server public -p 8787 -c-1",
    "audit": "node scripts/audit.js"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "wrangler": "^4"
  }
}
